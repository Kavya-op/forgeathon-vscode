{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run TrueForge Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${workspaceFolder}/flask-real",
        "--extensionDevelopmentPath=${workspaceFolder}/extension"
      ],
      "outFiles": [
        "${workspaceFolder}/extension/dist/**/*.js"
      ]
    }
  ]
}
